<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- En-tête / Titre -->
    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/titre"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- Carte du Compteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_card_counter"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/valeur_actuelle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/textViewCompteur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/primary"
            android:textSize="80sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls (+ et -) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDecrementer"
            android:layout_width="120dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="@string/decrementer"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:backgroundTint="@color/danger"
            app:cornerRadius="20dp"
            app:elevation="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonIncrementer"
            android:layout_width="120dp"
            android:layout_height="64dp"
            android:text="@string/incrementer"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="20dp"
            app:elevation="4dp" />
    </LinearLayout>

    <!-- Bouton Réinitialiser -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonReinitialiser"
        android:layout_width="260dp"
        android:layout_height="56dp"
        android:text="@string/reinitialiser"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp"
        app:elevation="2dp" />

</LinearLayout>